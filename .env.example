# ------------------------------------------------------------
# Building Data AI Agent
# ------------------------------------------------------------
# Docker Compose PostgreSQL bootstrap
POSTGRES_DB=buildings_db
POSTGRES_USER=buildings_admin
POSTGRES_PASSWORD=CHANGE_ME
READONLY_DB_PASSWORD=CHANGE_ME

# Local PostgreSQL application access (when running outside Docker Compose)
DATABASE_URL=postgresql://readonly_agent:CHANGE_ME@localhost:5432/buildings_db

# OpenAI
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5-mini

# Safety bounds
MAX_SQL_RETRIES=1
STATEMENT_TIMEOUT_MS=5000
MAX_RESULT_ROWS=200

# Provenance
PROVENANCE_LOG_PATH=logs/agent_provenance_ledger.jsonl
